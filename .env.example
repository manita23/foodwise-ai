# Environment variable template — copy to .env and fill in values
# Never commit the real .env file

# ── IBM watsonx.ai ──────────────────────────────────────────────────────────
# Your IBM Cloud API key (https://cloud.ibm.com/iam/apikeys)
WATSONX_API_KEY=

# watsonx.ai project ID (visible in the project URL on dataplatform.cloud.ibm.com)
WATSONX_PROJECT_ID=

# Regional endpoint — change to eu-de or jp-tok if needed
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ── Granite model IDs (do not change unless upgrading) ─────────────────────
# Chat / Q&A model
GRANITE_CHAT_MODEL=ibm/granite-3-3-8b-instruct

# Time-series forecasting model (TTM)
# Options: granite-ttm-512-96-r2 | granite-ttm-1024-96-r2 | granite-ttm-1536-96-r2
GRANITE_TTM_MODEL=ibm/granite-ttm-512-96-r2

# Embedding model (for RAG document vectorisation)
GRANITE_EMBED_MODEL=ibm/granite-embedding-278m-multilingual

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://foodwise:changeme@localhost:5432/foodwise

# ── Application ─────────────────────────────────────────────────────────────
# Secret used to sign JWT tokens
JWT_SECRET=change-this-to-a-random-secret

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173

# ── Vector store ────────────────────────────────────────────────────────────
# "chroma" for local development, "elasticsearch" for production
VECTOR_STORE_BACKEND=chroma

# Path used when VECTOR_STORE_BACKEND=chroma
CHROMA_PERSIST_DIR=./rag/vector_store

# Used when VECTOR_STORE_BACKEND=elasticsearch
# ELASTICSEARCH_URL=https://your-cluster.databases.appdomain.cloud:30000
# ELASTICSEARCH_API_KEY=
# ELASTICSEARCH_INDEX=foodwise-rag
